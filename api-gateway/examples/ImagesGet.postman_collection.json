      "item": [
        {
          "name": "Image",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response;",
                  "const base64Image = btoa(",
                  "    new Uint8Array(response.stream).reduce((data, byte) => data + String.fromCharCode(byte), '')",
                  ");",
                  "const contentType = response.headers.get('Content-Type') || 'image/jpeg';",
                  "const template = `",
                  "<html>",
                  "  <body style=\"margin:0;background:#1e1e1e;display:flex;justify-content:center;align-items:center;min-height:100vh;\">",
                  "    <img src=\"data:${contentType};base64,${base64Image}\" style=\"max-width:100%;max-height:100vh;object-fit:contain;\" />",
                  "  </body>",
                  "</html>",
                  "`;",
                  "pm.visualizer.set(template);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/octet-stream, application/problem+json"
              }
            ],
            "url": {
              "raw": "{{url}}/images/019d5e3c-fdce-75ba-838f-e0d1f2e6c41e",
              "host": [
                "{{url}}"
              ],
              "path": [
