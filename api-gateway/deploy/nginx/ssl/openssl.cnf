# openssl.cnf

[ req ]
default_bits       = 2048
default_keyfile    = shopapi.local.key
distinguished_name = req_distinguished_name
req_extensions     = req_ext
x509_extensions    = v3_ca
string_mask        = utf8only
prompt             = no

[ req_distinguished_name ]
CN                  = shopapi.local

[ req_ext ]
subjectAltName      = @alt_names

[ v3_ca ]
subjectAltName      = @alt_names

[ alt_names ]
DNS.1               = shopapi.local
DNS.2               = www.shopapi.local